  "jobs": [
    { "id": "mistral_zero_shot_sub25", "prompt_id": "mistral_zero_shot" },
    { "id": "calc_spec_sub25", "prompt_id": "calc_spec" },
    { "id": "encounter_cot_full_v2_sub25", "prompt_id": "encounter_cot_full_v2" }
  ]
}
